# Copy to docker/.env. This file is gitignored and never copied into the image.

# --- auth (pick one) ----------------------------------------------------------
# Subscription OAuth: run `claude setup-token` where you are logged in and paste
# the sk-ant-oat01-... token. Or an API key (per-token billing).
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- workspace ----------------------------------------------------------------
# Host directory mounted at /work: the project the agents act on. Runs land in
# <LH_WORKSPACE>/.lh-harness/runs/, uploads in <LH_WORKSPACE>/inbox/.
LH_WORKSPACE=../workspace

# --- web workbench ------------------------------------------------------------
# Required: the container binds 0.0.0.0, and lh-harness refuses a non-loopback
# bind without a bearer token. Paste it into the workbench's auth dialog.
LH_HARNESS_WEB_TOKEN=change-me
# LH_HARNESS_WEB_PORT=8799

# --- third-party model providers (see sdk/providers.json) ---------------------
# Select them per role in the workbench or with --model <provider>:<model>.
# ORCA_API_KEY=

# --- git identity for commits the executors make ------------------------------
GIT_AUTHOR_NAME=lh-harness
GIT_AUTHOR_EMAIL=harness@ai-ceo.local
