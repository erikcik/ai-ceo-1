{
  "name": "lh-harness-eray",
  "version": "0.1.7",
  "description": "LongHorizon-Harness (Manager -> Executor -> Auditor loop engineering) ported 1:1 to TypeScript on the Claude Agent SDK.",
  "type": "module",
  "scripts": {
    "lh-harness-eray": "node bin/lh-harness-eray.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "build:web": "npm --prefix frontend/web install && npm --prefix frontend/web run build",
    "web": "node bin/lh-harness-eray.mjs web",
    "doctor": "node bin/lh-harness-eray.mjs doctor"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.235",
    "smol-toml": "^1.8.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "bin": {
    "lh-harness-eray": "bin/lh-harness-eray.mjs"
  },
  "files": [
    "bin",
    "src",
    "providers.json",
    "frontend/web/dist",
    "README.md"
  ]
}
